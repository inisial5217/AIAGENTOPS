# Root environment template for CIFO Platform

# Application Environment
APP_ENV=development
PORT=8080
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000
AI_SERVICE_GRPC_PORT=50051

# Database (PostgreSQL 16)
POSTGRES_DB=cifo_db
POSTGRES_USER=cifo_admin
POSTGRES_PASSWORD=cifo_secure_password
DATABASE_DSN=postgres://cifo_admin:cifo_secure_password@localhost:5432/cifo_db?sslmode=disable

# Redis 7
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=cifo_redis_secret

# AI Providers (Insert API keys for development)
GOOGLE_API_KEY=your_google_ai_studio_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OLLAMA_BASE_URL=http://localhost:11434

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ArgoCD
ARGOCD_URL=https://localhost:8443
ARGOCD_TOKEN=your_argocd_auth_token

# Observability
VICTORIAMETRICS_URL=http://localhost:8428
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090
TEMPO_URL=http://localhost:3200
