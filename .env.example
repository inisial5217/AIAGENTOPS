# ==============================================================================
# CIFO ENTERPRISE IT MONITORING & AIOPS - GLOBAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# File ini adalah pusat konfigurasi utama (Single Source of Truth) untuk seluruh
# service CIFO: Backend Go, AI Microservice, Frontend Next.js, dan Docker Testbed.
#
# Petunjuk:
# 1. Kredensial Database, Redis, Vault, dan Observabilitas SUDAH DISET OTOMATIS
#    dengan nilai default untuk lokal. Anda TIDAK PERLU mengubahnya untuk development.
# 2. Untuk fitur AI dan Telegram Alert, cukup isi API Key yang ingin Anda aktifkan.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDERS (PILIH SALAH SATU ATAU LEBIH SESUAI KEBUTUHAN)
# ------------------------------------------------------------------------------
# A. GOOGLE GEMINI (REKOMENDASI UTAMA - GRATIS via Google AI Studio)
#    Dapatkan gratis di: https://aistudio.google.com/app/apikey
#    Format: AIzaSy...
GOOGLE_API_KEY=
GEMINI_API_KEY=

# B. OPENAI (Opsional jika ingin GPT-4o / GPT-4o Mini)
#    Dapatkan di: https://platform.openai.com/api-keys
#    Format: sk-...
OPENAI_API_KEY=

# C. ANTHROPIC CLAUDE (Opsional jika ingin Claude 3.5 Sonnet)
#    Dapatkan di: https://console.anthropic.com/
#    Format: sk-ant-...
ANTHROPIC_API_KEY=

# D. OLLAMA LOCAL LLM (Opsional - 100% Gratis Tanpa Internet & Tanpa API Key)
#    Jalankan Ollama di PC Anda (ollama run llama3 atau mistral)
#    Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. NOTIFIKASI INSIDEN TELEGRAM BOT (OPSIONAL)
# ------------------------------------------------------------------------------
# Token Bot Telegram untuk broadcast alert insiden server & kubernetes:
# - Buat bot baru di Telegram melalui: @BotFather (kirim perintah /newbot)
# - Dapatkan Chat ID Anda atau Grup melalui: @userinfobot atau @getidsbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. GITOPS & KUBERNETES ARGOCD (OPSIONAL / SUDAH ADA DEFAULT LOKAL)
# ------------------------------------------------------------------------------
# URL server ArgoCD (Default klaster lokal k3d: https://localhost:8443)
ARGOCD_URL=https://localhost:8443
# Token autentikasi JWT ArgoCD (generate via UI ArgoCD Settings -> Accounts -> Generate Token)
ARGOCD_TOKEN=

# ------------------------------------------------------------------------------
# 4. DATABASE & BROKER (PRE-CONFIGURED - SIAP PAKAI LOKAL)
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8080
FRONTEND_PORT=3001
AI_SERVICE_PORT=8000
AI_SERVICE_GRPC_PORT=50051

POSTGRES_DB=cifo_db
POSTGRES_USER=cifo_admin
POSTGRES_PASSWORD=cifo_secure_password
DATABASE_DSN=postgres://cifo_admin:cifo_secure_password@127.0.0.1:5432/cifo_db?sslmode=disable

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=cifo_redis_secret

# ------------------------------------------------------------------------------
# 5. HASHICORP VAULT & DOCKER PROXY (PRE-CONFIGURED)
# ------------------------------------------------------------------------------
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=cifo-vault-root-token
VAULT_ENABLED=true
DOCKER_HOST=tcp://127.0.0.1:2376

# ------------------------------------------------------------------------------
# 6. OBSERVABILITAS TELEMETRY (PRE-CONFIGURED)
# ------------------------------------------------------------------------------
VICTORIAMETRICS_URL=http://localhost:8428
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090
TEMPO_URL=http://localhost:3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
