# ==============================================================================
# CONTOH KONFIGURASI .ENV UNTUK LAPTOP 1 (REMOTE KE LAPTOP 2)
# Ganti 192.168.1.50 dengan Alamat IP LAN Laptop 2 Anda
# ==============================================================================

GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# URL server ArgoCD (di Laptop 2)
ARGOCD_URL=https://192.168.1.50:8444
ARGOCD_TOKEN=

APP_ENV=development
PORT=8080
FRONTEND_PORT=3001
AI_SERVICE_PORT=8000
AI_SERVICE_GRPC_PORT=50051

# Database & Cache (di Laptop 2)
POSTGRES_DB=cifo_db
POSTGRES_USER=cifo_admin
POSTGRES_PASSWORD=cifo_secure_password
DATABASE_DSN=postgres://cifo_admin:cifo_secure_password@192.168.1.50:5432/cifo_db?sslmode=disable
REDIS_ADDR=192.168.1.50:6379
REDIS_PASSWORD=cifo_redis_secret

# Vault & Docker Host (di Laptop 2)
VAULT_ADDR=http://192.168.1.50:8200
VAULT_TOKEN=cifo-vault-root-token
VAULT_ENABLED=true
DOCKER_HOST=tcp://192.168.1.50:2376

# Observabilitas Telemetri (di Laptop 2)
VICTORIAMETRICS_URL=http://192.168.1.50:8428
LOKI_URL=http://192.168.1.50:3100
PROMETHEUS_URL=http://192.168.1.50:9090
TEMPO_URL=http://192.168.1.50:3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.50:4318
