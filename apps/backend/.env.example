# Backend Go environment variables
PORT=8080
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 16
DATABASE_DSN=postgres://cifo_admin:cifo_secure_password@127.0.0.1:5432/cifo_db?sslmode=disable

# Redis 7
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=cifo_redis_secret

# Third-party Integrations
DOCKER_HOST=http://127.0.0.1:2375
ARGOCD_URL=https://127.0.0.1:8443
ARGOCD_TOKEN=
AI_SERVICE_URL=127.0.0.1:50051
